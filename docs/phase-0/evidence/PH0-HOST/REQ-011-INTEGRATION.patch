-//! TelosWeaver Core Daemon 진입점. Local Core API와 Scheduler는 아직 구현되지 않았습니다.
+//! Minimal Local API entrypoint proposal for REQ-011 (Spec §3.3, §19.5).
+use std::{collections::HashMap, path::PathBuf, process::ExitCode, sync::Arc};
+use telos_core::{
+    api::{ApiServer, ApiServerConfig},
+    execution::{DenyRuns, ExecutionSupervisor},
