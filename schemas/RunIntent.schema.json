{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunIntent",
  "type": "object",
  "properties": {
    "attempt": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "hostId": {
      "type": "string"
    },
    "idempotencyKey": {
      "type": "string"
    },
    "intentId": {
      "type": "string"
    },
    "nativeSessionId": {
      "type": [
        "string",
        "null"
      ]
    },
    "payloadDigest": {
      "description": "고정한 입력·정책·설정의 SHA-256입니다. 같은 키에 다른 값이 오면 거부합니다.",
      "type": "string"
    },
    "phase": {
      "$ref": "#/$defs/IntentPhase"
    },
    "process": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProcessIdentity"
        },
        {
          "type": "null"
        }
      ]
    },
    "provider": {
      "type": "string"
    },
    "recordedAt": {
      "type": "string"
    },
    "runId": {
      "type": "string"
    },
    "taskId": {
      "type": "string"
    },
    "taskRevision": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "updatedAt": {
      "type": "string"
    }
  },
  "required": [
    "intentId",
    "runId",
    "taskId",
    "taskRevision",
    "attempt",
    "idempotencyKey",
    "payloadDigest",
    "phase",
    "hostId",
    "provider",
    "recordedAt",
    "updatedAt"
  ],
  "$defs": {
    "IntentPhase": {
      "description": "실행 의도의 단계입니다 (§9.1 4번, §14.3).",
      "oneOf": [
        {
          "description": "의도만 기록했고 Adapter에 전달하지 않았습니다. 외부 부작용이 없습니다.",
          "type": "string",
          "const": "recorded"
        },
        {
          "description": "Adapter에 시작을 요청했지만 시작 결과(`RunStarted`)를 받지 못했습니다.",
          "type": "string",
          "const": "dispatched"
        },
        {
          "description": "시작 결과와 Native ID·프로세스 정체성을 받았습니다.",
          "type": "string",
          "const": "started"
        },
        {
          "description": "종료 결과를 확정했습니다.",
          "type": "string",
          "const": "settled"
        },
        {
          "description": "전달 전에 취소·거부되어 실행하지 않았습니다.",
          "type": "string",
          "const": "abandoned"
        }
      ]
    },
    "ProcessIdentity": {
      "description": "실행 중인 프로세스를 다시 찾을 때 쓰는 증거입니다. PID만으로 정체성을 확정하지 않습니다 (§14.3).",
      "type": "object",
      "properties": {
        "hostId": {
          "type": "string"
        },
        "pid": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "processStartedAt": {
          "description": "OS가 보고한 프로세스 시작 시각",
          "type": "string"
        },
        "runTokenDigest": {
          "description": "Run별 실행 토큰의 SHA-256. 토큰 원문은 저장하지 않습니다 (§14.1).",
          "type": "string"
        }
      },
      "required": [
        "hostId",
        "pid",
        "processStartedAt",
        "runTokenDigest"
      ]
    }
  }
}
