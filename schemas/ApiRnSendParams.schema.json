{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RnSendParams",
  "type": "object",
  "properties": {
    "endpoint": {
      "$ref": "#/$defs/EndpointRef"
    },
    "idempotencyKey": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "ttlSecs": {
      "description": "이 시간이 지나면 전달하지 않습니다 (COMM-07).",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "idempotencyKey",
    "endpoint",
    "text",
    "ttlSecs"
  ],
  "$defs": {
    "EndpointRef": {
      "description": "사람이 읽는 주소는 영구 Session ID가 아닙니다. 대상은 항상 이 정체성으로 고정합니다 (§12.2).",
      "type": "object",
      "properties": {
        "fingerprint": {
          "type": "string"
        },
        "hostId": {
          "type": "string"
        },
        "nativeSessionId": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        }
      },
      "required": [
        "hostId",
        "provider",
        "nativeSessionId",
        "fingerprint"
      ]
    }
  }
}
