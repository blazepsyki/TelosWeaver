{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunContext",
  "type": "object",
  "properties": {
    "attempt": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "contextSnapshotId": {
      "type": "string"
    },
    "controllerEpoch": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "hostId": {
      "type": "string"
    },
    "idempotencyKey": {
      "type": "string"
    },
    "policyRevision": {
      "type": "string"
    },
    "runId": {
      "description": "Core가 발급합니다. Adapter가 임의의 다른 Run을 만들지 않습니다.",
      "type": "string"
    },
    "session": {
      "$ref": "#/$defs/SessionRequest"
    },
    "taskId": {
      "type": "string"
    },
    "taskMcp": {
      "description": "Task MCP 연결 정보 (§9.2, H0). Task MCP를 주지 않는 Run은 비워 둡니다.",
      "anyOf": [
        {
          "$ref": "#/$defs/TaskMcpBinding"
        },
        {
          "type": "null"
        }
      ]
    },
    "taskRevision": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "workspaceId": {
      "type": "string"
    }
  },
  "required": [
    "runId",
    "taskId",
    "taskRevision",
    "attempt",
    "controllerEpoch",
    "hostId",
    "workspaceId",
    "contextSnapshotId",
    "policyRevision",
    "idempotencyKey",
    "session"
  ],
  "$defs": {
    "SessionMode": {
      "description": "Spec §8.1 문맥 전략.",
      "type": "string",
      "enum": [
        "fresh",
        "resume",
        "native-fork",
        "capsule"
      ]
    },
    "SessionRequest": {
      "type": "object",
      "properties": {
        "capsuleVersionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "$ref": "#/$defs/SessionMode"
        },
        "sourceSessionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceTurnId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "mode"
      ]
    },
    "TaskMcpBinding": {
      "description": "Run 시작 때 Adapter에 넘기는 연결 정보입니다. 자격 원문은 넣지 않고 Core 상태 디렉터리의 파일 경로만 넘깁니다.",
      "type": "object",
      "properties": {
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "command": {
          "description": "stdio MCP 서버로 띄울 실행 파일(`telos-weaver`)과 인자",
          "type": "string"
        },
        "credentialFile": {
          "description": "Run 범위 연결 자격 파일. 현재 사용자만 읽을 수 있게 만들고 Run 종료 때 폐기합니다.",
          "type": "string"
        },
        "serverName": {
          "description": "Provider 설정에 쓰는 MCP 서버 이름입니다. 고정 이름을 써서 Provider의 도구 Schema 캐시를 재사용합니다.",
          "type": "string"
        }
      },
      "required": [
        "serverName",
        "command",
        "args",
        "credentialFile"
      ]
    }
  }
}
