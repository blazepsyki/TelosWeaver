{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReportTaskResultOutput",
  "type": "object",
  "properties": {
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ArtifactVersionRef"
      }
    }
  },
  "required": [
    "artifacts"
  ],
  "$defs": {
    "ArtifactVersionRef": {
      "type": "object",
      "properties": {
        "artifactId": {
          "type": "string"
        },
        "versionId": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "artifactId",
        "versionId"
      ]
    }
  }
}
