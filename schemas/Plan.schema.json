{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plan",
  "description": "사용자 목표와 승인된 실행 구성입니다. 수정은 새 Revision이며 실행 중 묵시적으로 바꾸지 않습니다 (§5.1).",
  "type": "object",
  "properties": {
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "controllerEpoch": {
      "description": "마스터 제어권의 세대입니다. 재개·교체 시 올리고 이전 세대의 결정을 집행하지 않습니다 (§4.1, §14.3).",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "createdAt": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "masterTaskId": {
      "description": "마스터 실행을 기록하는 제어용 Task (`role: master`, §4.1)",
      "type": "string"
    },
    "projectId": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "status": {
      "$ref": "#/$defs/PlanStatus"
    },
    "updatedAt": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "projectId",
    "revision",
    "goal",
    "constraints",
    "status",
    "controllerEpoch",
    "masterTaskId",
    "createdAt",
    "updatedAt"
  ],
  "$defs": {
    "PlanStatus": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Active",
            "Completed",
            "Failed",
            "Cancelled"
          ]
        },
        {
          "description": "마스터 유실 등으로 새 결정을 보류한 상태입니다. 허용된 기존 Run은 정책에 따라 계속됩니다 (§14.2).",
          "type": "string",
          "const": "Held"
        }
      ]
    }
  }
}
