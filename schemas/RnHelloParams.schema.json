{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RnHelloParams",
  "type": "object",
  "properties": {
    "clientName": {
      "type": "string"
    },
    "clientVersion": {
      "type": "string"
    },
    "token": {
      "description": "`rpc-token`의 내용",
      "$ref": "#/$defs/SecretString"
    }
  },
  "required": [
    "clientName",
    "clientVersion",
    "token"
  ],
  "$defs": {
    "SecretString": {
      "description": "Wire에서는 일반 문자열이지만 `Debug`로 원문을 출력하지 않습니다.\n원문은 전송·검증이 필요한 곳에서 [`SecretString::expose`]로만 꺼냅니다.",
      "type": "string"
    }
  }
}
