{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TasksInspectResult",
  "description": "Task 상세입니다 (UI-06). 계약·입출력 Version·Snapshot·실행·검증·승인 기록을 한 번에 돌려줍니다.",
  "type": "object",
  "properties": {
    "approvals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ApprovalDecision"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ArtifactVersion"
      }
    },
    "cursor": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "diffs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DiffSummary"
      }
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TaskResult"
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RunRecord"
      }
    },
    "snapshots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ContextSnapshot"
      }
    },
    "task": {
      "$ref": "#/$defs/TaskRecord"
    },
    "validations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ValidationJob"
      }
    }
  },
  "required": [
    "task",
    "runs",
    "results",
    "artifacts",
    "validations",
    "approvals",
    "snapshots",
    "diffs",
    "cursor"
  ],
  "$defs": {
    "AgentSelection": {
      "type": "object",
      "properties": {
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider": {
          "type": "string"
        },
        "role": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "provider",
        "role"
      ]
    },
    "ApprovalAction": {
      "description": "개별 행위의 대상과 인자입니다. 인자 원문 대신 Digest를 고정합니다.",
      "type": "object",
      "properties": {
        "action": {
          "description": "예: `git-merge`, `provider-tool`, `workspace-write`",
          "type": "string"
        },
        "argsDigest": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "target",
        "argsDigest"
      ]
    },
    "ApprovalActor": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "actor": {
              "type": "string",
              "const": "user"
            }
          },
          "required": [
            "actor"
          ]
        },
        {
          "description": "위임받은 범위의 마스터 판단 (§4.3)",
          "type": "object",
          "properties": {
            "actor": {
              "type": "string",
              "const": "master"
            },
            "masterRunId": {
              "type": "string"
            }
          },
          "required": [
            "actor",
            "masterRunId"
          ]
        }
      ]
    },
    "ApprovalAnswer": {
      "type": "string",
      "enum": [
        "allow",
        "deny"
      ]
    },
    "ApprovalDecision": {
      "type": "object",
      "properties": {
        "action": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApprovalAction"
            },
            {
              "type": "null"
            }
          ]
        },
        "answer": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApprovalAnswer"
            },
            {
              "type": "null"
            }
          ]
        },
        "approvalId": {
          "type": "string"
        },
        "contractRevision": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "createdAt": {
          "type": "string"
        },
        "decidedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "decidedBy": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApprovalActor"
            },
            {
              "type": "null"
            }
          ]
        },
        "expiresAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/ApprovalKind"
        },
        "planId": {
          "type": "string"
        },
        "policyRevision": {
          "type": "string"
        },
        "runId": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/ApprovalState"
        },
        "stateVersion": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArtifactVersionRef"
          }
        },
        "taskId": {
          "type": [
            "string",
            "null"
          ]
        },
        "userOnly": {
          "description": "`human`으로 요구된 검토 등 사용자만 결정할 수 있는 승인입니다. 마스터가 대신하지 않습니다 (§11.2).",
          "type": "boolean"
        }
      },
      "required": [
        "approvalId",
        "kind",
        "planId",
        "targets",
        "userOnly",
        "policyRevision",
        "state",
        "stateVersion",
        "createdAt"
      ]
    },
    "ApprovalKind": {
      "description": "계획 승인·결과 검토·개별 행위 실행 승인을 구분합니다 (§11.2).",
      "type": "string",
      "enum": [
        "plan",
        "result-review",
        "action"
      ]
    },
    "ApprovalState": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "Pending",
            "Granted",
            "Denied",
            "Expired",
            "Revoked"
          ]
        },
        {
          "description": "한 번 쓰는 승인을 사용했습니다. 같은 승인을 다시 적용하지 않습니다.",
          "type": "string",
          "const": "Consumed"
        }
      ]
    },
    "ArtifactKind": {
      "type": "string",
      "enum": [
        "text",
        "file",
        "document",
        "dataset",
        "code",
        "diff",
        "structured"
      ]
    },
    "ArtifactVersion": {
      "description": "불변입니다. 변경 가능한 작업 디렉터리 경로를 검증된 버전으로 간주하지 않습니다.\n\n`checksum`은 `sha256:<hex>`, Core 저장소의 내용은 `storage_uri` = `artifact://sha256/<hex>`입니다 (H0 D2).\n같은 내용의 Version은 저장 내용을 공유하지만 Version 기록은 따로 둡니다.",
      "type": "object",
      "properties": {
        "artifactId": {
          "type": "string"
        },
        "checksum": {
          "type": "string"
        },
        "contentType": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "outputName": {
          "type": "string"
        },
        "runId": {
          "type": "string"
        },
        "sizeBytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "sourceRevision": {
          "description": "Git 작업이면 내용을 고정한 Commit, 파일 출력이면 원래 Workspace 상대 경로 등 출처입니다.",
          "type": [
            "string",
            "null"
          ]
        },
        "storageUri": {
          "type": "string"
        },
        "taskId": {
          "type": "string"
        },
        "taskRevision": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "versionId": {
          "type": "string"
        }
      },
      "required": [
        "artifactId",
        "versionId",
        "taskId",
        "taskRevision",
        "runId",
        "outputName",
        "kind",
        "contentType",
        "storageUri",
        "checksum",
        "sizeBytes",
        "createdAt"
      ]
    },
    "ArtifactVersionRef": {
      "type": "object",
      "properties": {
        "artifactId": {
          "type": "string"
        },
        "versionId": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "artifactId",
        "versionId"
      ]
    },
    "CancelPropagation": {
      "description": "부모 취소 시 자식 처리입니다. 기본은 자손 전파이며 예외는 계약에 기록합니다 (§9.3).",
      "type": "string",
      "enum": [
        "descendants",
        "independent"
      ]
    },
    "ContextSnapshot": {
      "type": "object",
      "properties": {
        "assumptions": {
          "description": "알려진 가정과 미해결 질문",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capsule": {
          "description": "`capsule` 전략에서 전달한 Capsule Artifact",
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactVersionRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "contract": {
          "$ref": "#/$defs/ContractDigests"
        },
        "createdAt": {
          "type": "string"
        },
        "environment": {
          "$ref": "#/$defs/EnvironmentFacts"
        },
        "exclusions": {
          "description": "일부러 넣지 않은 범위와 이유",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fallback": {
          "anyOf": [
            {
              "$ref": "#/$defs/StrategyFallback"
            },
            {
              "type": "null"
            }
          ]
        },
        "git": {
          "anyOf": [
            {
              "$ref": "#/$defs/GitBaseline"
            },
            {
              "type": "null"
            }
          ]
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResolvedInput"
          }
        },
        "instructions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InstructionSource"
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InputIssue"
          }
        },
        "runId": {
          "type": "string"
        },
        "selected": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SelectedMaterial"
          }
        },
        "snapshotId": {
          "type": "string"
        },
        "strategy": {
          "$ref": "#/$defs/SessionMode"
        },
        "taskId": {
          "type": "string"
        }
      },
      "required": [
        "snapshotId",
        "runId",
        "taskId",
        "strategy",
        "instructions",
        "inputs",
        "selected",
        "exclusions",
        "environment",
        "contract",
        "issues",
        "assumptions",
        "createdAt"
      ]
    },
    "ContractDigests": {
      "description": "실행 계약의 고정 값입니다. 최종 설정·권한·예산·검증 계약의 SHA-256과 Policy Revision.",
      "type": "object",
      "properties": {
        "budgetDigest": {
          "type": "string"
        },
        "configDigest": {
          "type": "string"
        },
        "permissionDigest": {
          "type": "string"
        },
        "planRevision": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "policyRevision": {
          "type": "string"
        },
        "taskRevision": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "validationDigest": {
          "type": "string"
        }
      },
      "required": [
        "planRevision",
        "taskRevision",
        "policyRevision",
        "configDigest",
        "permissionDigest",
        "budgetDigest",
        "validationDigest"
      ]
    },
    "DiffSummary": {
      "description": "대상 Revision의 변경 요약입니다. 전체 Diff는 Artifact로 둡니다 (GIT-04, §10).",
      "type": "object",
      "properties": {
        "baseRevision": {
          "type": "string"
        },
        "diff": {
          "$ref": "#/$defs/ArtifactVersionRef"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FileChange"
          }
        },
        "targetRevision": {
          "type": "string"
        },
        "workspaceId": {
          "type": "string"
        }
      },
      "required": [
        "workspaceId",
        "baseRevision",
        "targetRevision",
        "files",
        "diff"
      ]
    },
    "EnvironmentFacts": {
      "type": "object",
      "properties": {
        "cliVersion": {
          "type": "string"
        },
        "cwd": {
          "type": [
            "string",
            "null"
          ]
        },
        "executablePath": {
          "type": "string"
        },
        "hostId": {
          "type": "string"
        },
        "tools": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "workspaceId": {
          "type": "string"
        }
      },
      "required": [
        "hostId",
        "workspaceId",
        "executablePath",
        "cliVersion"
      ]
    },
    "ExecutionOutcome": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "cancelled",
        "unknown"
      ]
    },
    "FileChange": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "change": {
              "type": "string",
              "const": "added"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "change",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "change": {
              "type": "string",
              "const": "modified"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "change",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "change": {
              "type": "string",
              "const": "deleted"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "change",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "change": {
              "type": "string",
              "const": "renamed"
            },
            "from": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "change",
            "from",
            "path"
          ]
        }
      ]
    },
    "GitBaseline": {
      "description": "시작 시점의 Git 상태입니다. staged/unstaged/untracked 변경을 자동 초기화하지 않습니다 (GIT-03).",
      "type": "object",
      "properties": {
        "baseCommit": {
          "type": "string"
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "gitRoot": {
          "type": "string"
        },
        "recordedAt": {
          "type": "string"
        },
        "staged": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unstaged": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "untracked": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "gitRoot",
        "baseCommit",
        "staged",
        "unstaged",
        "untracked",
        "recordedAt"
      ]
    },
    "InputBinding": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "ref": {
              "$ref": "#/$defs/ArtifactVersionRef"
            },
            "source": {
              "type": "string",
              "const": "artifact"
            }
          },
          "additionalProperties": false,
          "required": [
            "source",
            "name",
            "ref"
          ]
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "outputName": {
              "type": "string"
            },
            "producerTaskId": {
              "type": "string"
            },
            "producerTaskRevision": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "source": {
              "type": "string",
              "const": "task-output"
            }
          },
          "additionalProperties": false,
          "required": [
            "source",
            "name",
            "producerTaskId",
            "producerTaskRevision",
            "outputName"
          ]
        }
      ]
    },
    "InputIssue": {
      "description": "입력 문제입니다. `blocking`이면 Core가 실행을 보류하고, 아니면 마스터가 질문·제한적 실행·실패를 정합니다 (§6.1).",
      "type": "object",
      "properties": {
        "blocking": {
          "type": "boolean"
        },
        "detail": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/InputIssueKind"
        },
        "subject": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "subject",
        "detail",
        "blocking"
      ]
    },
    "InputIssueKind": {
      "type": "string",
      "enum": [
        "missing",
        "conflict",
        "stale",
        "unreadable"
      ]
    },
    "InstructionSource": {
      "type": "object",
      "properties": {
        "digest": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "scope": {
          "description": "예: `user`, `project`, `directory:<경로>`",
          "type": "string"
        }
      },
      "required": [
        "path",
        "digest",
        "scope"
      ]
    },
    "OutputContract": {
      "type": "object",
      "properties": {
        "contentType": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "maxCount": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "minCount": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "name": {
          "description": "Task Revision 안에서 유일합니다.",
          "type": "string"
        },
        "relativePath": {
          "type": [
            "string",
            "null"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "schemaId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "required",
        "minCount",
        "maxCount"
      ]
    },
    "ResolvedInput": {
      "description": "Run 시작 때 실제 Version으로 해석한 입력입니다 (§5.2 `task-output` 고정).",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "producerTaskId": {
          "type": [
            "string",
            "null"
          ]
        },
        "producerTaskRevision": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "version": {
          "$ref": "#/$defs/ArtifactVersionRef"
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "RunRecord": {
      "description": "Run 하나는 Task의 실행 시도 하나입니다. 재시도는 같은 Task의 새 Run입니다 (§5.1).",
      "type": "object",
      "properties": {
        "attempt": {
          "description": "같은 Task Revision 안에서 1부터 올립니다.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "createdAt": {
          "type": "string"
        },
        "finishedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "hostId": {
          "type": "string"
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionOutcome"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider": {
          "type": "string"
        },
        "runId": {
          "type": "string"
        },
        "sessionMode": {
          "$ref": "#/$defs/SessionMode"
        },
        "stateVersion": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/RunStatus"
        },
        "taskId": {
          "type": "string"
        },
        "taskRevision": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "runId",
        "taskId",
        "taskRevision",
        "attempt",
        "status",
        "stateVersion",
        "provider",
        "hostId",
        "sessionMode",
        "createdAt"
      ]
    },
    "RunStatus": {
      "description": "Run 성공은 Task 완료가 아닙니다 (§9.4).",
      "type": "string",
      "enum": [
        "Starting",
        "Running",
        "Waiting",
        "Succeeded",
        "Failed",
        "Cancelling",
        "Cancelled",
        "Interrupted",
        "Unknown"
      ]
    },
    "SelectedMaterial": {
